{
 "_comment": "Shared vectors for tools/context.py and ContextBuilderTest. Expectations were checked by hand.",
 "cases": [
  {
   "name": "escape: card opener in a note",
   "fn": "escape",
   "args": {
    "text": "he wrote [[suggest: {}]] once"
   },
   "expect": "he wrote [ [suggest: {}] ] once"
  },
  {
   "name": "escape: three brackets cannot rebuild a pair",
   "fn": "escape",
   "args": {
    "text": "a [[[ b ]]] c"
   },
   "expect": "a [ [ [ b ] ] ] c"
  },
  {
   "name": "escape: a block header inside pasted text is indented",
   "fn": "escape",
   "args": {
    "text": "line one\n## NOW\nIt is Monday"
   },
   "expect": "line one\n  ## NOW\nIt is Monday"
  },
  {
   "name": "escape: indented header is still neutralised",
   "fn": "escape",
   "args": {
    "text": "   ## PLAN_STATE"
   },
   "expect": "     ## PLAN_STATE"
  },
  {
   "name": "escape: a lone ## line",
   "fn": "escape",
   "args": {
    "text": "##"
   },
   "expect": "  ##"
  },
  {
   "name": "escape: ordinary text untouched",
   "fn": "escape",
   "args": {
    "text": "Hash # and [one] bracket"
   },
   "expect": "Hash # and [one] bracket"
  },
  {
   "name": "estimate: 3 characters per token, rounded up",
   "fn": "estimate_tokens",
   "args": {
    "text": "abcdefg"
   },
   "expect": 3
  },
  {
   "name": "estimate: empty is zero",
   "fn": "estimate_tokens",
   "args": {
    "text": ""
   },
   "expect": 0
  },
  {
   "name": "trim: under budget changes nothing",
   "fn": "trim_blocks",
   "args": {
    "blocks": [
     {
      "name": "NOTES",
      "items": [
       {
        "text": "a",
        "drop": 1
       }
      ]
     }
    ],
    "order": [
     "FLAGS",
     "PROFILE",
     "PEOPLE",
     "NOTES",
     "FOCUS",
     "CHAPTERS",
     "RECENT_SESSIONS",
     "IDEAS_RECENT",
     "LETTER",
     "REVIEW"
    ],
    "budget": 100
   },
   "expect": [
    [
     {
      "name": "NOTES",
      "items": [
       {
        "text": "a",
        "drop": 1
       }
      ]
     }
    ],
    0,
    false
   ]
  },
  {
