        "numbers written in words",
        "never work out a date",
        "word for word"
      ],
      "max_words": 600
    },
    "chapter.md": {
      "placeholders": [
        "USER_NAME",
        "PERIOD",
        "PREVIOUS_CHAPTER",
        "REVIEWS",
        "LETTERS",
        "SUMMARIES",
        "QUOTES",
        "GOALS",
        "FOCUS_SUMMARIES",
        "NOTES"
      ],
      "must_contain": [
        "Still open:",
        "Never invent",
        "numbers written in words"
      ],
      "max_words": 900
    },
    "gardening.md": {
      "placeholders": [
        "USER_NAME",
        "NOTES",
        "PROFILE",
        "PEOPLE",
        "SUMMARIES"
      ],
      "must_contain": [
        "NEVER change, merge or retire",
