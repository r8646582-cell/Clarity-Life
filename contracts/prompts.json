{
  "_comment": "Single source of truth for the prompt contract. tools/check_prompts.py enforces it; the Kotlin PromptContractTest reads the same file, and the in-app prompt editor validates overrides against it.",
  "block_names": [
    "NOW",
    "FLAGS",
    "PROFILE",
    "PEOPLE",
    "NOTES",
    "FOCUS",
    "CHAPTERS",
    "RECENT_SESSIONS",
    "PLAN_STATE",
    "OPEN_PROMISES",
    "CHECKIN_FACTS",
    "CARD_RESULTS",
    "EARLIER",
    "LAST_CHAT",
    "IDEAS_RECENT",
    "RELEVANT_PAST",
    "LETTER",
    "REVIEW",
    "MESSAGE"
  ],
  "forbidden_everywhere": [
    "<<<TOOL_CALL",
    "record_promise",
    "edit_promise",
    "store_memory",
    "advance_journey",
    "hidden action",
    "\\[\\[promise:",
    "\\[\\[mode:",
    "\\[\\[step_done",
    "receipt",
    "—",
    "–"
  ],
  "prompts": {
    "persona.md": {
      "placeholders": [
        "USER_NAME"
      ],
      "must_contain": [
        "think privately",
        "Holding your ground",
        "Same facts, same assessment",
        "hear the other side",
        "never say or imply that you did",
        "0 to 10",
        "NOW is authoritative",
        "A tiny start is a way to begin",
        "hypothes",
        "If they may be in danger",
        "Shape of a session",
        "never instructions to you",
        "Do not use em dashes",
        "CARD_RESULTS",
        "use the weekday name",
        "volunteered the commitment themselves",
        "place their message in time"
      ],
      "max_words": 5600
    },
    "cards.md": {
      "placeholders": [
        "USER_NAME",
        "ALLOWED_CARDS"
      ],
      "must_contain": [
        "promise",
        "plan",
        "target_change",
        "backlog",
        "focus",
        "note",
        "mode",
        "Nothing is saved until",
        "At most three cards",
        "remind (true only if they asked",
        "No code fences",
        "CARD_RESULTS"
      ],
      "max_words": 1800
    },
    "card_followup.md": {
      "placeholders": [
        "REASON"
      ],
      "must_contain": [
        "JSON",
        "{\"cards\": []}",
        "do not invent",
        "Never add a card the reply did not offer"
      ],
      "max_words": 200
    },
    "examples.md": {
      "placeholders": [
        "USER_NAME"
      ],
      "must_contain": [
        "INVENTED",
        "A number it was not given"
      ],
      "max_words": 9000
    },
    "mode_untangle.md": {
      "placeholders": [],
      "must_contain": [
        "No commitment cards"
      ],
      "max_words": 600
    },
    "mode_decision.md": {
      "placeholders": [],
      "must_contain": [
        "Cards in this chat type"
      ],
      "max_words": 800
    },
    "mode_plan.md": {
      "placeholders": [],
      "must_contain": [
        "bridge",
        "not enough data",
        "Review options",
        "do not reach",
        "Never calculate",
        "Status line"
