        "SESSION_DATE",
        "CHAT_TYPE",
        "CONTEXT",
        "FOCUS_SUMMARY",
        "CHECKIN_FACTS",
        "DELETED_NOTES",
        "PREVIOUS_SUMMARY",
        "TRANSCRIPT"
