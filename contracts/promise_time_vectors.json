{
 "_comment": "Shared cases for PromiseTimes: tools/promise_times.py (test_promise_times.py) and PromiseTimes.kt (PromiseTimesTest) must give exactly these results. 2026-10-10 is a Saturday. Each expectation was checked by hand against the rules in tools/promise_times.py.",
 "cases": [
  {
   "name": "plain tomorrow with a 24-hour time",
   "args": {
    "phrase": "tomorrow 17:00",
    "now": "2026-10-10T21:40"
   },
   "expect": {
    "status": "ok",
    "date": "2026-10-11",
    "time": "17:00"
   }
  },
  {
   "name": "weekday name with am",
   "args": {
    "phrase": "Sunday 8am",
    "now": "2026-10-10T21:40"
   },
   "expect": {
    "status": "ok",
    "date": "2026-10-11",
    "time": "08:00"
   }
  },
  {
   "name": "today, later the same evening",
   "args": {
    "phrase": "today 22:30",
    "now": "2026-10-10T21:40"
   },
   "expect": {
    "status": "ok",
    "date": "2026-10-10",
    "time": "22:30"
   }
  },
  {
   "name": "today, a time that has passed: picker with the time only",
   "args": {
    "phrase": "today 21:00",
    "now": "2026-10-10T21:40"
   },
   "expect": {
    "status": "pick",
    "date": null,
    "time": "21:00"
   }
  },
  {
   "name": "test bench: tomorrow at 8pm in the evening",
