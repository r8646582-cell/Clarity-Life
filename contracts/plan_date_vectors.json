{
 "_comment": "Shared cases for PlanDates: tools/plan_dates.py (test_plan_dates.py) and PlanDates.kt (PlanDatesTest) must give exactly these results. 2026-10-09 is a Friday. Each expectation was checked by hand against the rules in tools/plan_dates.py.",
 "cases": [
  {
   "name": "today is the day key",
   "fn": "read_day",
   "args": {
    "phrase": "today",
    "today": "2026-10-09"
   },
   "expect": "2026-10-09"
  },
  {
   "name": "tomorrow",
   "fn": "read_day",
   "args": {
    "phrase": "tomorrow",
    "today": "2026-10-09"
   },
   "expect": "2026-10-10"
  },
  {
   "name": "tmrw",
   "fn": "read_day",
   "args": {
    "phrase": "Tmrw",
    "today": "2026-10-09"
   },
   "expect": "2026-10-10"
  },
  {
   "name": "a weekday later this week",
   "fn": "read_day",
   "args": {
    "phrase": "Sat",
    "today": "2026-10-09"
   },
   "expect": "2026-10-10"
  },
  {
   "name": "a weekday that is today means today",
   "fn": "read_day",
   "args": {
    "phrase": "Friday",
    "today": "2026-10-09"
   },
   "expect": "2026-10-09"
  },
  {
   "name": "a weekday earlier in the week means next week",
   "fn": "read_day",
   "args": {
    "phrase": "Mon",
    "today": "2026-10-09"
   },
   "expect": "2026-10-12"
  },
  {
