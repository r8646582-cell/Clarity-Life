   "args": {
    "phrase": "20 Nov",
    "today": "2026-10-09"
   },
   "expect": "2026-11-20"
  },
  {
   "name": "month first, with filler",
   "fn": "read_day",
   "args": {
    "phrase": "by Nov 20",
    "today": "2026-10-09"
   },
   "expect": "2026-11-20"
  },
  {
   "name": "ordinal day and long month",
   "fn": "read_day",
   "args": {
    "phrase": "20th November",
    "today": "2026-10-09"
   },
   "expect": "2026-11-20"
  },
  {
   "name": "weekday before a date that agrees",
   "fn": "read_day",
   "args": {
    "phrase": "Sat 17 Oct",
    "today": "2026-10-09"
   },
   "expect": "2026-10-17"
  },
  {
